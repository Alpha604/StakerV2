rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Functions
    function isSignedIn() { return request.auth != null; }
    function isAdmin() { 
      return isSignedIn() && (
        request.auth.token.email in ["romeo.brawlstars59@gmail.com", "lafrancaise.desjeux@outlook.fr", "mimizerzer27@gmail.com"] || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin")
      ); 
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }

    // User Functions
    function isValidUserConfig(data) {
      return data.keys().hasAll(["id", "username", "balance", "vault", "role", "status"])
        && data.id is string && data.id.size() <= 128
        && data.username is string && data.username.size() <= 64
        && data.balance is number && data.balance >= 0
        && data.vault is number && data.vault >= 0
        && data.role in ["user", "admin"]
        && data.status in ["pending", "approved", "suspended", "banned"];
    }

    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin(); // Admin can view all users
      allow create: if isSignedIn() && request.auth.uid == userId 
        && isValidUserConfig(incoming()) 
        && incoming().id == userId
        && incoming().status == "approved"
        && incoming().vault == 0
        && (
          (incoming().role == "user" && incoming().balance == 100) ||
          (incoming().role == "admin" && incoming().balance == 1000000 && request.auth.token.email in ["romeo.brawlstars59@gmail.com", "lafrancaise.desjeux@outlook.fr", "mimizerzer27@gmail.com"])
        );

      allow update: if isSignedIn() && (
        isAdmin() || 
        (request.auth.uid == userId && isValidUserConfig(incoming()) && incoming().role == existing().role && incoming().status == existing().status)
      );
      
      allow delete: if isAdmin();
    }

    // Bet Functions
    function isValidBetConfig(data) {
      return data.keys().hasAll(["id", "userId", "userName", "game", "betAmount", "multiplier", "payout", "timestamp"])
        && data.id is string
        && data.userId is string
        && data.userName is string && data.userName.size() <= 64
        && data.game is string && data.game.size() <= 128
        && data.betAmount is number
        && data.multiplier is number
        && data.payout is number
        && data.timestamp is number;
    }

    match /bets/{betId} {
      allow read: if true; // Public activity feed
      allow create: if isSignedIn() && request.auth.uid == incoming().userId && isValidBetConfig(incoming());
      allow list: if true;
    }
  }
}
