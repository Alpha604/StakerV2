{
  "entities": {
    "User": {
      "title": "User",
      "description": "A user's profile and wallet balance.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "The UID matching auth.uid" },
        "username": { "type": "string" },
        "email": { "type": "string", "description": "User's email" },
        "photoURL": { "type": "string", "description": "User's avatar URL" },
        "balance": { "type": "number" },
        "vault": { "type": "number" },
        "totalWagered": { "type": "number" },
        "totalWon": { "type": "number" },
        "role": { "type": "string", "enum": ["user", "admin"] },
        "status": { "type": "string", "enum": ["pending", "approved", "suspended", "banned"] },
        "rank": { "type": "string" },
        "suspensionEndsAt": { "type": "number" },
        "suspensionReason": { "type": "string" },
        "createdAt": { "type": "number" },
        "lastOnline": { "type": "number" }
      },
      "required": ["id", "username", "balance", "vault", "role", "status"]
    },
    "Bet": {
      "title": "Bet",
      "description": "A record of a game bet for the live feed.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "game": { "type": "string" },
        "betAmount": { "type": "number" },
        "multiplier": { "type": "number" },
        "payout": { "type": "number" },
        "timestamp": { "type": "number" }
      },
      "required": ["userId", "userName", "game", "betAmount", "multiplier", "payout", "timestamp"]
    },
    "AdminRequest": {
      "title": "AdminRequest",
      "description": "A request made by a user to admins.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "username": { "type": "string" },
        "type": { "type": "string", "enum": ["ban_appeal", "rank_upgrade"] },
        "status": { "type": "string", "enum": ["pending", "accepted", "rejected"] },
        "createdAt": { "type": "number" },
        "adminResponse": { "type": "string" },
        "resolvedAt": { "type": "number" }
      },
      "required": ["userId", "userEmail", "username", "type", "status", "createdAt"]
    },
    "Config": {
      "title": "Config",
      "description": "Global application configuration.",
      "type": "object",
      "properties": {}
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Live chat messages.",
      "type": "object",
      "properties": {
        "author": { "type": "string" },
        "authorId": { "type": "string" },
        "rank": { "type": "string" },
        "isVip": { "type": "boolean" },
        "text": { "type": "string" },
        "timestamp": { "type": "object" },
        "timeStr": { "type": "string" }
      },
      "required": ["author", "authorId", "rank", "isVip", "text", "timestamp", "timeStr"]
    }
  },
  "firestore": {
    "/config/{configId}": {
      "schema": "Config",
      "description": "Global config documents."
    },
    "/chat_messages/{messageId}": {
      "schema": "ChatMessage",
      "description": "Live chat message stream."
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles and wallet data."
    },
    "/bets/{betId}": {
      "schema": "Bet",
      "description": "Global bet stream."
    },
    "/admin_requests/{requestId}": {
      "schema": "AdminRequest",
      "description": "Requests made by users to admins."
    }
  }
}
